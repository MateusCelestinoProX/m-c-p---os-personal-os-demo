{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "McpPersonalOs",
  "version": "1.0.0",
  "identifier": "com.mateuscelestino.personalos",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "node build.js"
  },
  "app": {
    "windows": [
      {
        "title": "M.C.P PERSONAL OS",
        "width": 1440,
        "height": 900,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
